# Copy this file to .env and fill in your real keys.
# server.js reads these via process.env — never commit the real .env to GitHub.

PORT=3000

# football-data.org (real fixtures). Free tier: 10 req/min, 12 competitions.
FDORG_KEY=881689e6b5a341c6bdd557bfa6c55834

# API-Football (api-football.com / api-sports.io) — REAL bookmaker odds.
# Free tier: ~100 req/day. Sign up at https://dashboard.api-football.com/
# This is DIFFERENT from FDORG_KEY above — football-data.org has no odds
# on its free tier, which is why this second key exists. Required for real
# odds; without it, matches will show fixtures but no odds/analysis.
APIFOOTBALL_KEY=your_api_football_key_here

# AI engines used to write analysis/commentary ON TOP OF the real odds above.
# Gemini tried first, Groq as fallback. At least one is required.
# The AI never invents odds — only APIFOOTBALL_KEY odds are ever shown.
GEMINI_KEY=your_gemini_key_here
GROQ_KEY=your_groq_key_here
