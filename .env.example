# Copy this file to .env and fill in your real keys.
# server.js reads these via process.env — never commit the real .env to GitHub.

PORT=3000

# ── 7-PROVIDER FOOTBALL DATA CASCADE ────────────────────────────────────
# JuanAi's fixtures now come from up to 7 providers, tried in this exact
# priority order (see footballProviders.js): the first CONFIGURED provider
# that returns data for a given date is used; the rest are only tried if
# the ones ahead of them are unconfigured, fail, or return nothing.
#
# EVERY provider below supports MULTIPLE comma-separated keys for
# automatic rotation — if one key hits its rate limit (429) or gets
# rejected (401/403), requests automatically move to the next key. Add
# more capacity by adding more keys to the list; no code changes needed.
#   Example: BIGBALLSDATA_KEYS=key1,key2,key3,key4,key5

# 1) BigBallsData / BigFootball — TOP of the priority order. Free tier:
# 100 req/min, 2,000 req/day PER KEY (bigFootballData.js enforces both
# limits client-side with a safety margin, scaled by however many keys
# you add here, and caches aggressively).
BIGBALLSDATA_KEYS=your_bigballsdata_key_here
# Legacy single-key name — still read as a fallback if BIGBALLSDATA_KEYS
# isn't set, for anyone who deployed before multi-key support existed.
BIGFOOTBALL_API_KEY=
BIGFOOTBALL_BASE_URL=https://api.bigballsdata.com

# 2) API-Football (v3.football.api-sports.io). Sign up at api-sports.io.
API_FOOTBALL_KEYS=

# 3) football-data.org — same env var name change as BigBallsData above;
# FDORG_KEY (below) still works as a fallback if this isn't set.
FOOTBALL_DATA_KEYS=881689e6b5a341c6bdd557bfa6c55834
# Free tier: 10 req/min PER KEY, 12 competitions. Confirmed in production:
# exceeding this can trigger a temporary block that outlasts a simple
# per-minute reset (persisted across a full service restart in testing),
# so avoiding the limit in the first place matters more than recovering
# from it after the fact. Sign up for additional free accounts (different
# email each time) at football-data.org to get more keys.
FDORG_KEY=881689e6b5a341c6bdd557bfa6c55834

# 4) Sportmonks Football API v3 (api.sportmonks.com/v3/football).
SPORTMONKS_KEYS=

# 5) TheSportsDB. Free tier keys are typically short numeric/alphanumeric
# strings (their docs historically used the shared key "1" or "3" for
# free-tier testing) — use your own registered key here.
THESPORTSDB_KEYS=

# 6) Highlightly football API (soccer.highlightly.net).
HIGHLIGHTLY_KEYS=

# 7) API-Sports — kept as a fully separate key pool per explicit request,
# even though api-sports.io's football product is branded "API-FOOTBALL"
# (item 2 above) rather than a separately-named "API-Sports" football
# endpoint. If this is meant to be a second, separate api-sports.io
# account, put that account's key here. See providers/apiSportsProvider.js.
API_SPORTS_KEYS=

# AI engines used to generate odds/predictions for those real fixtures.
# Gemini tried first, Groq as fallback. At least one is required.
GEMINI_KEY=your_gemini_key_here
GROQ_KEY=your_groq_key_here

# MongoDB Atlas connection string — used ONLY for API key storage.
# Required for API keys to survive Render restarts/redeploys/spin-downs.
# Render's free tier has an ephemeral filesystem, so without this, any
# API keys generated in the admin panel are lost the next time the service
# restarts (which free services do automatically after inactivity).
# Get this from Atlas → Connect → Drivers. Example:
# mongodb+srv://juanai_app:<password>@juanai-cluster.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGO_URI=your_mongodb_atlas_connection_string_here

# Bookmaker-style margin (overround) applied on top of the AI's raw "fair"
# odds estimate — this is what actually gives the platform a structural
# edge, the same way real books never offer true 50/50 on a coin flip.
# Expressed as a decimal: 0.06 = 6% margin. Real bookmakers typically run
# 5-8% depending on market/competition. The AI's pre-margin numbers are
# still available in aiOdds.fairOdds for auditing. Applies to ALL matches —
# pre-match AND live re-pricing.
ODDS_MARGIN=0.06

# SharpAPI (sharpapi.io) — real bookmaker market odds, free tier.
# Optional but strongly recommended: without this AND without ODDSAPIIO_KEY
# below, ALL odds are AI-generated estimates. With it, pre-match odds use
# REAL prices from actual sportsbooks whenever SharpAPI's free tier (2
# books: DraftKings + FanDuel) covers the match — confirmed via real testing
# to cover EPL, La Liga, Serie A, Bundesliga, Ligue 1, MLS, Champions League
# on the free tier. Does NOT cover World Cup or lower-division leagues on
# free tier (confirmed via testing). Live in-play odds still use the AI
# repricing path regardless (free tier has a ~60s data delay, too slow for
# live score tracking). Sign up free, no card required, at sharpapi.io.
SHARPAPI_KEY=your_sharpapi_key_here

# odds-api.io — second real-odds provider, tried after SharpAPI for any
# match SharpAPI doesn't cover. Free tier: 100 req/hour PER KEY, no card
# required, also only 2 bookmakers, but confirmed via real testing to have
# much broader league depth (lower divisions, international friendlies)
# than SharpAPI. Also confirmed to NOT cover World Cup on free tier as of
# this build. Sign up free at odds-api.io.
#
# Supports MULTIPLE comma-separated keys for rotation — since 100/hour per
# key is a real, easily-hit ceiling once many matches need pricing across a
# merged fixture list, each additional key adds meaningful headroom (e.g. 5
# keys = ~500/hour). Sign up multiple times with different emails to get
# more keys. Single key still works fine — this is purely additive.
# Example with 3 keys: ODDSAPIIO_KEY=key1abc,key2def,key3ghi
ODDSAPIIO_KEY=your_odds_api_io_key_here
# Which bookmaker to request from odds-api.io — confirmed working in testing
# with "Bet365". Free tier only unlocks 2 books; change this if your account
# has different ones enabled (no endpoint tells you which without trying).
ODDSAPIIO_BOOKMAKER=Bet365
